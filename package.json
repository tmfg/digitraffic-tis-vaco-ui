{
  "name": "digitraffic-tis-vaco-ui",
  "version": "1.45.4",
  "description": "Fintraffic TIS VACO UI",
  "keywords": [],
  "author": "",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest test",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "test:e2e": "cd src/test/e2e && npx playwright test",
    "coverage": "vitest run --coverage",
    "nyc:coverage": "npx nyc report --reporter html --reporter lcov --reporter text  -t src/test/coverage/ --report-dir coverage/",
    "sbom": "cyclonedx-npm --output-file sbom/${GITHUB_SHA:-bom}.json"
  },
  "dependencies": {
    "@azure/msal-browser": "5.15.0",
    "@azure/msal-react": "5.5.0",
    "@lit-labs/react": "2.1.3",
    "@observablehq/plot": "0.6.17",
    "@popperjs/core": "2.11.8",
    "axios": "1.18.1",
    "dotenv": "17.4.2",
    "i18next": "26.3.1",
    "lit": "3.3.3",
    "lucide": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/ui": "4.1.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "isomorphic-fetch": "3.0.0",
    "jsdom": "30.0.1",
    "lit-html": "3.3.3",
    "msal-react-tester": "0.3.1",
    "msw": "2.15.0",
    "nyc": "18.0.0",
    "playwright-i18next-fixture": "1.0.0",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "shadow-dom-testing-library": "1.14.1",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-istanbul": "9.0.1",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-svgr": "5.2.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "minimatch@>=10": {
      "brace-expansion": "^5.0.7"
